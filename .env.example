# ==============================================================================
# Global Quest Technologies (GQT) - Enterprise Backend Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
STUDENT_PORTAL_URL=https://internships.gqtech.in
ADMIN_PORTAL_URL=https://admin.gqtech.in

# ------------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gqt_internships?schema=public&connection_limit=20&pool_timeout=30"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gqt_internships?schema=public"

# ------------------------------------------------------------------------------
# JWT Authentication & Tokens
# ------------------------------------------------------------------------------
JWT_SECRET="gqt_super_secret_enterprise_jwt_signing_key_2026_prod"
JWT_REFRESH_SECRET="gqt_super_secret_refresh_token_signing_key_2026_prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Redis & BullMQ Queue Infrastructure
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# Storage Engine (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="gqt-enterprise-cdn"
CLOUDINARY_API_KEY="789456123456789"
CLOUDINARY_API_SECRET="gqt_cloudinary_secure_api_secret_key"
CLOUDINARY_UPLOAD_PRESET="gqt_internship_docs"

# ------------------------------------------------------------------------------
# Transactional Email Engine (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASSWORD="SG.example_sendgrid_production_api_key"
SMTP_FROM="Global Quest Technologies <admissions@gqtech.in>"
SMTP_SUPPORT_EMAIL="support@gqtech.in"

# ------------------------------------------------------------------------------
# WhatsApp Business Cloud API (Official Meta Webhook)
# ------------------------------------------------------------------------------
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_PHONE_NUMBER_ID="109823475019283"
WHATSAPP_ACCESS_TOKEN="EAAG...meta_cloud_api_token"
META_WEBHOOK_VERIFY_TOKEN="gqt_meta_webhook_verification_token_2026"

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay Placeholder)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_8984920194"
RAZORPAY_KEY_SECRET="rzp_sec_gqt_production_secret"

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS="http://localhost:3000,https://internships.gqtech.in,https://admin.gqtech.in"
